package android.content;import java.util.*;import android.os.Bundle;import android.net.Uri;
public class Intent {public static final String ACTION_SCREEN_OFF="screenOff";private String action;private Uri data;private Map<String,Object> extras=new HashMap<>();public Intent(){}public Intent(String a){action=a;}public String getAction(){return action;}public Uri getData(){return data;}public Intent setData(Uri d){data=d;return this;}public Intent putExtra(String k,Bundle b){extras.put(k,b);return this;}public Intent putExtra(String k,int i){extras.put(k,i);return this;}public Bundle getBundleExtra(String k){return (Bundle)extras.get(k);}public int getIntExtra(String k,int d){return extras.containsKey(k)?(Integer)extras.get(k):d;}}
